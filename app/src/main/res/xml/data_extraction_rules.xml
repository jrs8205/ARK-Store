<?xml version="1.0" encoding="utf-8"?>
<!-- Backups and device-to-device transfers from Android 12 on. The GitHub token stays on
     the device it was given to. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="github.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="github.xml" />
    </device-transfer>
</data-extraction-rules>
