<?xml version="1.0" encoding="utf-8"?>
<!-- Backups and device-to-device transfers from Android 12 on. The GitHub token stays on
     the device it was given to, and so does what is true of this device alone: whether root
     was given, and where the files saved for the user are. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="github.xml" />
        <exclude domain="sharedpref" path="root.xml" />
        <exclude domain="sharedpref" path="saved_apks.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="github.xml" />
        <exclude domain="sharedpref" path="root.xml" />
        <exclude domain="sharedpref" path="saved_apks.xml" />
    </device-transfer>
</data-extraction-rules>
